{
  "name": "livrolog",
  "author": "Arnon Rodrigues <arnonrdp@gmail.com> (https://arnon.dev)",
  "description": "A place for you to organize everything you've read.",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "yarn lint:oxlint && yarn lint:eslint",
    "format": "prettier --write .",
    "quality": "yarn type-check && yarn lint && yarn build",
    "format-check": "prettier --check src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@quasar/extras": "^2.0.2",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.18.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.0.0",
    "google-auth-library": "^10.9.1",
    "html2canvas": "^1.4.1",
    "jwt-decode": "^4.0.0",
    "laravel-echo": "^2.4.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pusher-js": "^8.6.0",
    "quasar": "^2.23.1",
    "secure-ls": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0"
  },
  "resolutions": {
    "flatted": ">=3.4.2",
    "serialize-javascript": ">=7.0.5",
    "uuid": ">=11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.0",
    "@quasar/vite-plugin": "^1.12.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
